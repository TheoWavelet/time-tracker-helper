{
  "name": "time-tracking-helper",
  "version": "2.2.1",
  "description": "Personal time-tracking overlay app",
  "main": "./out/main/index.js",
  "author": {
    "name": "Time Tracker Contributors",
    "email": "noreply@example.com"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --build --clean && electron-vite build",
    "start": "electron-vite preview",
    "generate:icons": "node scripts/generate-icons.mjs",
    "dist": "npm run generate:icons && npm run build && electron-builder --win nsis",
    "dist:linux": "npm run generate:icons && npm run build && electron-builder --linux AppImage deb",
    "package:extension": "npm run generate:icons && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-extension.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "postinstall": "electron-builder install-app-deps && npm run generate:icons",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.timetrackinghelper.app",
    "productName": "Time Tracker",
    "artifactName": "Time-Tracker-${version}-Setup.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "!**/.vscode/*",
      "!src/*",
      "!browser-extension/*",
      "!docs/*",
      "!*.ts",
      "!tsconfig*.json",
      "!electron.vite.config.*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/tray-icon.png",
        "to": "tray-icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "Time-Tracker-${version}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.33.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.4",
    "ws": "^8.21.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.0.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  }
}
